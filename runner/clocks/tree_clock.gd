func                        ________OVERRIDES________              ()->void:pass

func start( seconds: float ) -> void:
	running = true
	_timer.start( maxf( seconds, 0.001 ) )


func stop() -> void:
	running = false
	if not is_instance_valid( _timer ):
		return

	_timer.stop()
	_timer.queue_free()
	_timer = null


#         ███    ███ ███████ ████████ ██   ██  ██████  ██████  ███████         #
#         ████  ████ ██         ██    ██   ██ ██    ██ ██   ██ ██              #
