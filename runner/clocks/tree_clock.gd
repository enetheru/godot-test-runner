#         ██  ██  ██ ██         ██    ██   ██ ██    ██ ██   ██      ██         #
#         ██      ██ ███████    ██    ██   ██  ██████  ██████  ███████         #
func                        _________METHODS_________              ()->void:pass

func bind( tree: SceneTree ) -> void:
	var prior: Node = tree.root.get_node_or_null( "CaseClock" )
	if prior != null:
		prior.queue_free()

	_timer = Timer.new()
	_timer.name = "CaseClock"
	_timer.one_shot = true
	var err := _timer.timeout.connect( _on_timeout )
	if err != OK:
		push_error( "tree_clock.bind: connect failed (%s)" % error_string( err ) )
	tree.root.add_child( _timer )
